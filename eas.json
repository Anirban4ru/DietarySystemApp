{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "resourceClass": "medium"
      },
      "cache": {
        "key": "v2",
        "paths": [
          "node_modules",
          ".gradle/caches",
          ".gradle/wrapper"
        ]
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "cache": {
        "key": "v1",
        "paths": [
          "node_modules",
          ".gradle/caches",
          ".gradle/wrapper"
        ]
      },
      "channel": "production",
      "env": {
        "GRADLE_OPTS": "-Dorg.gradle.jvmargs=\"-Xmx4096m -XX:MaxMetaspaceSize=512m\" -Dorg.gradle.parallel=true -Dorg.gradle.daemon=true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
