# ==============================================================================
# NOURISH (Intelligent Dietary Systems) — Environment Configuration Template
# ==============================================================================
# Instructions:
# Copy this file to .env and populate with your verified project credentials.
# Do NOT commit production secrets (.env) to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration (Public App Access)
# Source: Supabase Dashboard > Project Settings > API
# ------------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://cbzojfasctnwyivksqde.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_cPfyOclRVYWJLTR0fzzMwA_DLnukREW

# ------------------------------------------------------------------------------
# 2. Supabase Edge Functions Secrets (Backend Only - Set in Supabase Vault)
# Set via: npx supabase secrets set KEY=VALUE
# ------------------------------------------------------------------------------
# Supabase Service Role Key: Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Gemini API Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Shared Secret for Cron Job Authentication (e.g. daily-expiry-notifications)
# Generate a strong 32+ character random string (e.g. openssl rand -hex 32)
CRON_SECRET=your_strong_random_cron_secret_here

# Backend Store Verification Secret (RevenueCat Secret Key or StoreKit Private Key)
# Source: RevenueCat Dashboard > Project Settings > API Keys > Secret API Key
STORE_VERIFICATION_SECRET=your_revenuecat_secret_api_key_here

# Backend Feature Flags (Leave 'false' until tested)
ENABLE_REAL_PURCHASES=false
ENABLE_PUSH_NOTIFICATIONS=false

# ------------------------------------------------------------------------------
# 3. Subscriptions & In-App Purchases (Client Configuration)
# ------------------------------------------------------------------------------
# Feature flag to switch from sandbox/disabled to live Google Play / App Store purchases
EXPO_PUBLIC_ENABLE_REAL_PURCHASES=false

# RevenueCat Public SDK API Keys
# Source: RevenueCat Dashboard > Project Settings > API Keys > Public App Specific Keys
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_your_revenuecat_android_public_key_here
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_your_revenuecat_ios_public_key_here

# In-App Purchase Product IDs configured in Google Play Console & Apple App Store
EXPO_PUBLIC_STORE_PRODUCT_ANNUAL=nourish_pro_annual
EXPO_PUBLIC_STORE_PRODUCT_MONTHLY=nourish_pro_monthly
